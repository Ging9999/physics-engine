# Simple pyramid — 5 vertices, 6 triangular faces
# Vertices: 4 base corners + apex
v -0.5  0.0 -0.5
v  0.5  0.0 -0.5
v  0.5  0.0  0.5
v -0.5  0.0  0.5
v  0.0  1.0  0.0

# Face normals
vn  0.0 -1.0  0.0
vn  0.0  0.4472  0.8944
vn  0.8944  0.4472  0.0
vn  0.0  0.4472 -0.8944
vn -0.8944  0.4472  0.0

# Bottom face (two triangles, winding CCW from below)
f 1//1 3//1 2//1
f 1//1 4//1 3//1
# Front face (v4, v3, v5)
f 4//2 3//2 5//2
# Right face (v3, v2, v5)
f 3//3 2//3 5//3
# Back face (v2, v1, v5)
f 2//4 1//4 5//4
# Left face (v1, v4, v5)
f 1//5 4//5 5//5
